# Copy to .env and fill in.  `make init` does this for you and
# generates the secrets.  .env is gitignored — keep it that way.

# ── Model ──────────────────────────────────────────────────────────
# Loaded from a local directory, not a hub repo id. `make fetch-llm`
# (run by install.sh) downloads them to ~/models, which is bind-mounted
# read-only at /models. A repo id would need hub resolution, and HF_HUB_OFFLINE=1
# makes that fail even when the files are present. A path never lies.
#   MODEL_DIR is the host directory; MODEL_ID is the path inside.
MODEL_DIR=${HOME}/models
MODEL_ID=/models/qwen3.8-27b-nvfp4
# Where `make fetch-llm` downloads the weights from (Apache-2.0).
MODEL_REPO=Inferact/Qwen3.8-27B-NVFP4
SERVED_MODEL_NAME=therapist-base

# 32K, not the 64K in the plan and not the model's 256K ceiling.
# The plan budgeted 15 GB for the weights; they are actually 22.9 GiB
# once the vision tower is dropped, because the embedding, lm_head and
# linear-attention projections are excluded from NVFP4 quantisation and
# load in bf16. That leaves roughly 3-4 GiB for KV, and KV costs
# 64 KiB/token. docs/gpu-notes.md shows the arithmetic.
# Raise it only after reading the "GPU KV cache size" line in the vLLM
# startup log — that number is the ground truth, not this comment.
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.94

# auto, NOT fp8. fp8 KV forces the FlashInfer backend, which JIT-compiles
# on the first request and kills the engine. See infra/vllm/entrypoint.sh.
KV_CACHE_DTYPE=auto
ATTENTION_BACKEND=FLASH_ATTN
MAX_NUM_SEQS=2

# Multi-token prediction speculative decoding. Proven on this model;
# costs ~0.8 GiB. Turn on once the stack is stable.
SPECULATIVE_MTP=false

# Pinned to the version verified against these exact weights on an
# RTX 5090. 0.27.1 predates Qwen3_5ForConditionalGeneration
# and cannot load this model at all. The FlashInfer incompatibility that
# 0.28.0 was blamed for is real but is caused by fp8 KV cache, not by the
# version — KV_CACHE_DTYPE=auto above is the actual fix.
VLLM_VERSION=v0.28.0

# ── Paths ──────────────────────────────────────────────────────────
# Hugging Face cache for the embedder, reranker and tokenizer files.
HF_CACHE_DIR=${HOME}/.cache/huggingface

# ── Retrieval ──────────────────────────────────────────────────────
QDRANT_VERSION=v1.12.4
QDRANT_COLLECTION=corpus
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# cpu at query time, and this is not a fallback — it is the only thing
# that fits. The 27B weights leave under a gigabyte spare once the KV
# cache is allocated, and the embedder plus reranker want ~2.4 GB.
# Ingestion overrides this to cuda in docker-compose.ingest.yml, which
# is fine because ingestion runs with vLLM stopped.
EMBED_DEVICE=cpu
EMBED_BATCH_SIZE=32

# ── Feature flags ──────────────────────────────────────────────────
# Memory is on: it is how the agent learns your name and your situation,
# and it is stored only in the local Postgres volume. `make forget` wipes it.
# Retrieval is switched on by install.sh once the research corpus is built.
RETRIEVAL_ENABLED=false
MEMORY_ENABLED=true
SAFETY_ENABLED=true

# ── Storage ────────────────────────────────────────────────────────
POSTGRES_USER=therapist
POSTGRES_PASSWORD=            # generated by `make init`
POSTGRES_DB=therapist

# ── Frontend ───────────────────────────────────────────────────────
OPENWEBUI_VERSION=main
WEBUI_NAME=Therapist
WEBUI_SECRET_KEY=             # generated by `make init`
RAG_API_KEY=local

# ── Ingestion ──────────────────────────────────────────────────────
# NCBI asks automated clients to identify themselves. Required.
CONTACT_EMAIL=
# Optional. Raises the E-utilities rate limit from 3/s to 10/s.
# https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=

# ── Misc ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Daily practice ─────────────────────────────────────────────────
# The between-session layer: three or four concrete things a day, and a
# record of whether they happened. Adds a `therapist-daily` entry to the
# model picker. See services/rag/app/daily.py.
DAILY_ENABLED=true
# Optional. Leave blank and the agent learns who matters to you by asking,
# the same way it learns everything else. Set it only if you want the daily
# relationship items pinned to one named person from day one.
PARTNER_NAME=
# Your local timezone, e.g. Europe/London. `make init` detects it.
TZ=UTC

# ── Stance controls ────────────────────────────────────────────────
# Screen the agent's own output, not just your input. Deterministic, in
# code, and it overrules the model rather than asking it nicely.
SAFETY_OUTPUT_CHECK=true
# Spend the opening exchanges understanding before moving to what to do.
PACING_ENABLED=true
